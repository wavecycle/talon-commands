os: mac
-

settings():
    key_wait = 8.0

return: key(enter)
[context] menu key: key(ctrl-return)
open [file|folder]: key(cmd-down)
app close: key(cmd-q)

go: key(cmd-shift-g)

grab left: key(alt-shift-left)
grab right: key(alt-shift-right)
grab up: key(shift-up)
grab up all: key(shift-alt-up)
grab down: key(shift-down)
grab down all: key(shift-alt-down)

jump left: key(alt-left)
jump right: key(alt-right)

home: key(cmd-left)
end: key(cmd-right)

menu top: key(ctrl-shift-f2)
screen (full|maximize): key(ctrl-cmd-f)