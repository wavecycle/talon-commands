os: windows
os: linux
app.name: Visual Studio Code
app.name: Code
-

settings: key(ctrl-,)
[keyboard] shortcuts:
    key(ctrl-k)
    key(ctrl-s)

panel (explore|explorer): key(ctrl-shift-e)
panel search: key(ctrl-shift-f)
panel source control: key(ctrl-shift-g)
panel debug: key(ctrl-shift-d)
panel extensions: key(ctrl-shift-x)

menu file: key(alt-f)
menu edit: key(alt-e)
menu selection: key(alt-s)
menu view: key(alt-v)
menu go: key(alt-g)
menu run: key(alt-r)
menu terminal: key(alt-t)
menu help: key(alt-h)

splitter last: key(ctrl-alt-left)
splitter [next]: key(ctrl-alt-right)